# Copy to .env and edit. Every line is optional.

# ---- LLM ----------------------------------------------------------------
# mock   = runs with no API key (extractive answers) - good for testing the UI and pipeline
# openai = any OpenAI-compatible endpoint
LLM_PROVIDER=mock

# OpenAI
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your-key-here
# LLM_MODEL=gpt-4o-mini

# Groq (free tier available)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.1-8b-instant

# Local Ollama (free, runs on your laptop: `ollama pull llama3.1:8b`)
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b

# ---- Verifier and retrieval models ------------------------------------------
# auto = NLI model if sentence-transformers is installed, else lexical
VERIFIER=auto
USE_DENSE=true
USE_RERANKER=true
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# NLI_MODEL=cross-encoder/nli-deberta-v3-small

# ---- Retrieval ----------------------------------------------------------------
CHUNK_WORDS=100
TOP_K=6
CANDIDATE_K=30

# ---- Detection thresholds (tune on the dev split, then freeze) ---------------
MIN_TOP_RELEVANCE=0.45
PASSAGE_RELEVANT=0.35
MIN_RELEVANT_FRACTION=0.5
CLAIM_SUPPORTED=0.6
MIN_ANSWER_COVERAGE=0.6
CONFLICT_THRESHOLD=0.7
MAX_REPAIRS=2
